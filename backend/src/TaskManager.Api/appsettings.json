{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "Service": {
    "Name": "task-manager-api"
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "task-manager",
    "Audience": "task-manager-web",
    "LifetimeMinutes": 60
  }
}
